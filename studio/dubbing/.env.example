# Dubbing service environment variables (placeholders only — never commit real values)

# Public URL of this service
DUBBING_URL=http://localhost:8002
OPENROUTER_MODEL=google/gemini-2.5-pro

# Standard cross-service URLs
STORE_URL=http://localhost:9000
AI_GATEWAY_URL=http://localhost:4000
TTS_SERVICE_URL=http://localhost:8002
CHATWOOT_URL=http://localhost:3000

# Clerk authentication (Dubbing only; Store and Chatwoot remain on Supabase)
CLERK_ISSUER=https://deciding-quagga-70.clerk.accounts.dev
CLERK_JWKS_URL=https://deciding-quagga-70.clerk.accounts.dev/.well-known/jwks.json
CLERK_AUDIENCE=pird-dubbing
CLERK_AUDIENCE_REQUIRED=true

# Convex data layer
CONVEX_URL=http://127.0.0.1:3210
DATA_BACKEND=convex

# Supabase data layer (temporary until Convex cutover)
DATABASE_URL=postgresql://user:pass@db.supabase.co:5432/postgres
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_me

# Object storage for source + dubbed videos (Cloudflare R2)
R2_ACCESS_KEY_ID=replace_me
R2_SECRET_ACCESS_KEY=replace_me
R2_BUCKET=replace_me
R2_ENDPOINT=replace_me

# TTS configuration
TTS_PROVIDER=minimax  # minimax | chatterbox
MINIMAX_API_KEY=replace_me

# Auth between services (shared internal secret)
INTERNAL_API_KEY=your-internal-shared-key

OPEN_ROUTER_API_KEY=replace_me
FISH_SPEECH_API_KEY=replace_me
HF_TOKEN=replace_me
GEMINI_API_KEY=replace_me
ASSEMBLYAI_API_KEY=replace_me
DEEPGRAM_API_KEY=replace_me
REDIS_URL=redis://localhost:6379/0

WAYL_API_TOKEN=
WAYL_WEBHOOK_SECRET=
USD_TO_IQD_RATE=1500
WAYL_REDIRECT_BASE_URL=
